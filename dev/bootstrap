#!/usr/bin/env bash
#
# dev/bootstrap — idempotent dev-environment bootstrap for WDR (Wavelink).
#
# Installs, when absent:
#   - rustup (official sh.rustup.rs, noninteractive, minimal profile)
#   - just (via `cargo install just`; falls back to `apt-get install -y just` if cargo is unavailable)
#
# Verifies docker availability and warns (does not fail) when docker is missing.
# Emits an environment summary and writes dev/env.sh for `source` in the current session.
#
# Usage:
#   ./dev/bootstrap          # from the repo root
#   bash dev/bootstrap       # same
#
# Re-runnable / idempotent: installs are skipped when the binaries already exist.
# No side effects outside the standard cargo/rustup homes and dev/.
#
# Only guards writes to dev/; everything else stays read-only for this task.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEV_DIR="$REPO_ROOT/dev"
CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
CARGO_BIN="${CARGO_HOME}/bin"

info()  { printf '[bootstrap] %s\n' "$*"; }
warn()  { printf '[bootstrap][warn] %s\n' "$*" >&2; }
die()   { printf '[bootstrap][error] %s\n' "$*" >&2; exit 1; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# 1. rustup (skip if present)
# ---------------------------------------------------------------------------
if [ -x "$RUSTUP_HOME/rustup" ] || [ -x "$CARGO_BIN/rustup" ] || command_exists rustup; then
    info "rustup already present; skipping install."
else
    info "rustup not found; installing via sh.rustup.rs (-y --profile minimal)."
    if command_exists curl; then
        for attempt in 1 2 3; do
            if curl --proto '=https' --tlsv1.2 -sSf --retry 3 --retry-connrefused https://sh.rustup.rs -o /tmp/rustup-init.sh; then
                break
            fi
            warn "rustup installer fetch attempt $attempt failed; retrying."
            [ "$attempt" = 3 ] && die "could not fetch rustup installer from sh.rustup.rs."
            sleep 2
        done
        sh /tmp/rustup-init.sh -y --profile minimal --no-modify-path
    elif command_exists wget; then
        wget -qO /tmp/rustup-init.sh --tries=3 https://sh.rustup.rs
        sh /tmp/rustup-init.sh -y --profile minimal --no-modify-path
    else
        die "neither curl nor wget available to fetch rustup installer."
    fi
    rm -f /tmp/rustup-init.sh
fi

# Ensure the pinned toolchain from rust-toolchain.toml is installed.
if [ -x "$CARGO_BIN/rustup" ] || command_exists rustup; then
    export PATH="$CARGO_BIN:$PATH"
    info "Installing toolchain pinned in rust-toolchain.toml (stable)."
    rustup toolchain install stable --profile minimal
fi

# ---------------------------------------------------------------------------
# 2. just
# ---------------------------------------------------------------------------
if command_exists just; then
    info "just already present; skipping install."
elif [ -x "$CARGO_BIN/cargo" ] || command_exists cargo; then
    info "Installing just via cargo install (this may take a few minutes)."
    cargo install just --locked
elif command_exists apt-get; then
    warn "cargo unavailable; falling back to apt-get for just."
    sudo apt-get update
    sudo apt-get install -y just
else
    warn "just not installed and no cargo/apt path available; install manually."
fi

# Ensure the just binary lands on path even when cargo was installed by this script.
if [ -x "$CARGO_BIN/just" ] && ! command_exists just; then
    export PATH="$CARGO_BIN:$PATH"
fi

# ---------------------------------------------------------------------------
# 3. Docker check (warn only)
# ---------------------------------------------------------------------------
if command_exists docker && docker version >/dev/null 2>&1; then
    info "docker: OK ($(docker version --format '{{.Server.Version}}' 2>/dev/null || echo present))."
else
    warn "docker: NOT available or daemon not running. Dev container / compose tasks (netem, emitters) will be unavailable."
fi

# ---------------------------------------------------------------------------
# 3.5 cargo-ndk + Android Rust targets (WS-G bridge .so build; idempotent)
# ---------------------------------------------------------------------------
if command_exists cargo; then
    if command_exists cargo-ndk; then
        info "cargo-ndk already present."
    else
        info "Installing cargo-ndk 4.1.2 (pinned; cargo-ndk bridge tooling, WS-G)."
        cargo install cargo-ndk --version 4.1.2 --locked \
            || warn "cargo-ndk install failed; the android-ci gate installs it."
    fi
    info "Adding Android Rust cross targets (aarch64/armv7/x86_64, idempotent)."
    rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android \
        || warn "rustup target add (android) failed; the android-ci gate adds them."
fi

# ---------------------------------------------------------------------------
# 4. Write dev/env.sh and recap
# ---------------------------------------------------------------------------
cat > "$DEV_DIR/env.sh" <<'EOF'
# Generated by dev/bootstrap. Source into your shell:
#   source dev/env.sh
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
case ":$PATH:" in
  *":$CARGO_HOME/bin:"*) ;;
  *) export PATH="$CARGO_HOME/bin:$PATH" ;;
esac
EOF
chmod +x "$DEV_DIR/env.sh"

export PATH="$CARGO_BIN:$PATH"

info "----- environment summary -----"
info "cargo:  $(command -v cargo 2>/dev/null && cargo --version 2>/dev/null || echo 'MISSING')"
info "rustc:  $(command -v rustc 2>/dev/null && rustc --version 2>/dev/null || echo 'MISSING')"
info "rustup: $(command -v rustup 2>/dev/null && rustup --version 2>/dev/null | cut -d' ' -f1-2 || echo 'MISSING')"
info "just:   $(command -v just 2>/dev/null && just --version 2>/dev/null || echo 'MISSING')"
info "docker: $(command -v docker 2>/dev/null || echo 'MISSING')"
info "WDR_DEV_ENV: ${WDR_DEV_ENV:-unset}"
info "Detail: source $DEV_DIR/env.sh to add tools to PATH."
info "--------------------------------------------------"

if ! command_exists cargo || ! command_exists rustc || ! command_exists just; then
    warn "Some tools are missing; see messages above. Typically fixed automatically by rustup toolchain install; re-run ./dev/bootstrap."
else
    info "bootstrap complete."
fi
